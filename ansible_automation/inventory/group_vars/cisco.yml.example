---
# Cisco device group variables
# Copy this file to cisco.yml and fill in values for your lab.
# cisco.yml is gitignored so your credentials never land in the public repo.

ansible_user: CHANGEME
ansible_password: CHANGEME
ansible_network_os: ios
ansible_connection: network_cli

# Optional: Additional connection parameters
ansible_become: yes
ansible_become_method: enable
# ansible_become_password: <enable_password_if_different>

# Optional: SSH parameters
# ansible_port: 22
# ansible_timeout: 30
